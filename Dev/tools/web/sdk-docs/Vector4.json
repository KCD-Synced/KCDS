{
  "type": "Vector4",
  "group": "Math",
  "summary": "Four numbers, { x, y, z, w }. Arithmetic methods modify the vector and return it, so call clone() first if you still need the original.",
  "fields": {
    "x": {
      "type": "number",
      "summary": "The first component. You can assign to it.",
      "readonly": false
    },
    "y": {
      "type": "number",
      "summary": "The second component. You can assign to it.",
      "readonly": false
    },
    "z": {
      "type": "number",
      "summary": "The third component. You can assign to it.",
      "readonly": false
    },
    "w": {
      "type": "number",
      "summary": "The fourth component. You can assign to it.",
      "readonly": false
    }
  },
  "members": {
    "zero": {
      "summary": "(0, 0, 0, 0).",
      "returns": "Vector4",
      "example": "const nothing = kcds.math.Vector4.zero(); // Vector4(0, 0, 0, 0)",
      "exampleLua": "local nothing = kcds.math.Vector4.zero() -- Vector4(0, 0, 0, 0)",
      "exampleCs": "var nothing = Vector4.Zero(); // Vector4(0, 0, 0, 0)"
    },
    "one": {
      "summary": "(1, 1, 1, 1).",
      "returns": "Vector4",
      "example": "const ones = kcds.math.Vector4.one(); // Vector4(1, 1, 1, 1)",
      "exampleLua": "local ones = kcds.math.Vector4.one() -- Vector4(1, 1, 1, 1)",
      "exampleCs": "var ones = Vector4.One(); // Vector4(1, 1, 1, 1)"
    },
    "set": {
      "summary": "Sets the components: set(x, y, z, w).",
      "returns": "Vector4",
      "example": "const v = kcds.math.Vector4.zero().set(1, 2, 3, 4); // Vector4(1, 2, 3, 4)",
      "exampleLua": "local v = kcds.math.Vector4.zero():set(1, 2, 3, 4) -- Vector4(1, 2, 3, 4)",
      "exampleCs": "var v = Vector4.Zero().Set(1, 2, 3, 4); // Vector4(1, 2, 3, 4)"
    },
    "add": {
      "summary": "Adds another vector to this one.",
      "params": {
        "other": "The vector to add."
      },
      "returns": "Vector4",
      "example": "const sum = new kcds.math.Vector4(1, 2, 3, 4).add(new kcds.math.Vector4(1, 1, 1, 1)); // Vector4(2, 3, 4, 5)",
      "exampleLua": "local sum = kcds.math.Vector4.new(1, 2, 3, 4):add(kcds.math.Vector4.new(1, 1, 1, 1)) -- Vector4(2, 3, 4, 5)",
      "exampleCs": "var sum = new Vector4(1, 2, 3, 4).Add(new Vector4(1, 1, 1, 1)); // Vector4(2, 3, 4, 5)"
    },
    "sub": {
      "summary": "Subtracts another vector from this one.",
      "params": {
        "other": "The vector to subtract."
      },
      "returns": "Vector4",
      "example": "const difference = new kcds.math.Vector4(5, 5, 5, 5).sub(new kcds.math.Vector4(1, 2, 3, 4)); // Vector4(4, 3, 2, 1)",
      "exampleLua": "local difference = kcds.math.Vector4.new(5, 5, 5, 5):sub(kcds.math.Vector4.new(1, 2, 3, 4)) -- Vector4(4, 3, 2, 1)",
      "exampleCs": "var difference = new Vector4(5, 5, 5, 5).Sub(new Vector4(1, 2, 3, 4)); // Vector4(4, 3, 2, 1)"
    },
    "mul": {
      "summary": "Multiplies every component by a number.",
      "params": {
        "scalar": "The factor."
      },
      "returns": "Vector4",
      "example": "const doubled = new kcds.math.Vector4(1, 2, 3, 4).mul(2); // Vector4(2, 4, 6, 8)",
      "exampleLua": "local doubled = kcds.math.Vector4.new(1, 2, 3, 4):mul(2) -- Vector4(2, 4, 6, 8)",
      "exampleCs": "var doubled = new Vector4(1, 2, 3, 4).Mul(2); // Vector4(2, 4, 6, 8)"
    },
    "div": {
      "summary": "Divides every component by a number (not 0).",
      "params": {
        "scalar": "The divisor."
      },
      "returns": "Vector4",
      "example": "const halved = new kcds.math.Vector4(2, 4, 6, 8).div(2); // Vector4(1, 2, 3, 4)",
      "exampleLua": "local halved = kcds.math.Vector4.new(2, 4, 6, 8):div(2) -- Vector4(1, 2, 3, 4)",
      "exampleCs": "var halved = new Vector4(2, 4, 6, 8).Div(2); // Vector4(1, 2, 3, 4)"
    },
    "dot": {
      "summary": "The dot product with another vector.",
      "params": {
        "other": "The other vector."
      },
      "returns": "number",
      "example": "const dot = new kcds.math.Vector4(1, 2, 3, 4).dot(new kcds.math.Vector4(1, 0, 0, 1)); // 5",
      "exampleLua": "local dot = kcds.math.Vector4.new(1, 2, 3, 4):dot(kcds.math.Vector4.new(1, 0, 0, 1)) -- 5",
      "exampleCs": "var dot = new Vector4(1, 2, 3, 4).Dot(new Vector4(1, 0, 0, 1)); // 5"
    },
    "length": {
      "summary": "The vector's length.",
      "type": "number",
      "example": "const length = new kcds.math.Vector4(1, 2, 2, 4).length; // 5",
      "exampleLua": "local length = kcds.math.Vector4.new(1, 2, 2, 4).length -- 5",
      "exampleCs": "var length = new Vector4(1, 2, 2, 4).Length; // 5"
    },
    "lengthSquared": {
      "summary": "The length squared.",
      "type": "number",
      "example": "const squared = new kcds.math.Vector4(1, 2, 2, 4).lengthSquared; // 25",
      "exampleLua": "local squared = kcds.math.Vector4.new(1, 2, 2, 4).lengthSquared -- 25",
      "exampleCs": "var squared = new Vector4(1, 2, 2, 4).LengthSquared; // 25"
    },
    "normalize": {
      "summary": "Scales this vector to length 1 (a zero vector stays zero).",
      "returns": "Vector4",
      "example": "const unit = new kcds.math.Vector4(0, 0, 3, 4).normalize(); // about Vector4(0, 0, 0.6, 0.8)",
      "exampleLua": "local unit = kcds.math.Vector4.new(0, 0, 3, 4):normalize() -- about Vector4(0, 0, 0.6, 0.8)",
      "exampleCs": "var unit = new Vector4(0, 0, 3, 4).Normalize(); // about Vector4(0, 0, 0.6, 0.8)"
    },
    "lerp": {
      "summary": "Moves this vector towards a target: t = 0 stays, 1 reaches it.",
      "params": {
        "target": "The target.",
        "t": "How far, 0 to 1."
      },
      "returns": "Vector4",
      "example": "const between = new kcds.math.Vector4(0, 0, 0, 0).lerp(new kcds.math.Vector4(4, 8, 12, 16), 0.25); // Vector4(1, 2, 3, 4)",
      "exampleLua": "local between = kcds.math.Vector4.new(0, 0, 0, 0):lerp(kcds.math.Vector4.new(4, 8, 12, 16), 0.25) -- Vector4(1, 2, 3, 4)",
      "exampleCs": "var between = new Vector4(0, 0, 0, 0).Lerp(new Vector4(4, 8, 12, 16), 0.25); // Vector4(1, 2, 3, 4)"
    },
    "distance": {
      "summary": "The distance to another point.",
      "params": {
        "other": "The other point."
      },
      "returns": "number",
      "example": "const apart = new kcds.math.Vector4(0, 0, 0, 0).distance(new kcds.math.Vector4(1, 2, 2, 4)); // 5",
      "exampleLua": "local apart = kcds.math.Vector4.new(0, 0, 0, 0):distance(kcds.math.Vector4.new(1, 2, 2, 4)) -- 5",
      "exampleCs": "var apart = new Vector4(0, 0, 0, 0).Distance(new Vector4(1, 2, 2, 4)); // 5"
    },
    "clone": {
      "summary": "A copy.",
      "returns": "Vector4",
      "example": "const original = new kcds.math.Vector4(1, 2, 3, 4);\nconst copy = original.clone().mul(10); // original stays Vector4(1, 2, 3, 4)",
      "exampleLua": "local original = kcds.math.Vector4.new(1, 2, 3, 4)\nlocal copy = original:clone():mul(10) -- original stays Vector4(1, 2, 3, 4)",
      "exampleCs": "var original = new Vector4(1, 2, 3, 4);\nvar copy = original.Clone().Mul(10); // original stays Vector4(1, 2, 3, 4)"
    },
    "x": {
      "example": "console.log(new kcds.math.Vector4(1, 2, 3, 4).x); // 1",
      "exampleLua": "print(kcds.math.Vector4.new(1, 2, 3, 4).x) -- 1",
      "exampleCs": "Log.Info(new Vector4(1, 2, 3, 4).X); // 1"
    },
    "y": {
      "example": "console.log(new kcds.math.Vector4(1, 2, 3, 4).y); // 2",
      "exampleLua": "print(kcds.math.Vector4.new(1, 2, 3, 4).y) -- 2",
      "exampleCs": "Log.Info(new Vector4(1, 2, 3, 4).Y); // 2"
    },
    "z": {
      "example": "console.log(new kcds.math.Vector4(1, 2, 3, 4).z); // 3",
      "exampleLua": "print(kcds.math.Vector4.new(1, 2, 3, 4).z) -- 3",
      "exampleCs": "Log.Info(new Vector4(1, 2, 3, 4).Z); // 3"
    },
    "w": {
      "example": "console.log(new kcds.math.Vector4(1, 2, 3, 4).w); // 4",
      "exampleLua": "print(kcds.math.Vector4.new(1, 2, 3, 4).w) -- 4",
      "exampleCs": "Log.Info(new Vector4(1, 2, 3, 4).W); // 4"
    }
  }
}
