root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,cc,cxx}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.{cmake,txt}]
indent_style = space
indent_size = 2

[*.{md,yml,yaml,json,toml}]
indent_style = space
indent_size = 2
